# macOS metadata
.DS_Store

# Synthea source clone
.synthea/

# Local Python environment
/.venv/

# Generated data
data/

# MED-COPILOT files required to run the existing pipeline
!/med_copilot/data/
/med_copilot/data/*
!/med_copilot/data/guidelines/

/med_copilot/data/guidelines/*
!/med_copilot/data/guidelines/.gitattributes
!/med_copilot/data/guidelines/settings.yaml
!/med_copilot/data/guidelines/prompts/
!/med_copilot/data/guidelines/output/

/med_copilot/data/guidelines/prompts/*
!/med_copilot/data/guidelines/prompts/*.txt

/med_copilot/data/guidelines/output/*
!/med_copilot/data/guidelines/output/communities.parquet
!/med_copilot/data/guidelines/output/community_reports.parquet
!/med_copilot/data/guidelines/output/entities.parquet
!/med_copilot/data/guidelines/output/relationships.parquet
!/med_copilot/data/guidelines/output/text_units.parquet
!/med_copilot/data/guidelines/output/covariates.parquet
!/med_copilot/data/guidelines/output/lancedb/

/med_copilot/data/guidelines/output/lancedb/*
!/med_copilot/data/guidelines/output/lancedb/default-entity-description.lance/
# LanceDB's data directory contains the required vector fragments.
!/med_copilot/data/guidelines/output/lancedb/default-entity-description.lance/data/

# Per-patient review files (generated by review_cohort.py)
docs/review/

# Claude Code session memory (stored in ~/.claude, not the repo)
memory/

# ignore PDFs
*.pdf

# Codex project instructions
AGENTS.md

# bytecode pycaches 
*.pyc
